# Plantilla para crear .env.
# Uso: cp .env.example .env
# Este archivo no contiene secretos reales.

# Angular local
WEB_API_URL=http://localhost:8082/api
STRIPE_PUBLIC_KEY=pk_test_replace-me

# Auth
AUTH_SERVER_PORT=8084
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=change-this-password
AUTH_DATABASE_URL=jdbc:postgresql://auth-postgres:5432/auth_db
AUTH_DATABASE_USERNAME=auth
AUTH_DATABASE_PASSWORD=change-this-password
REDIS_HOST=auth-redis
REDIS_PORT=6379
REDIS_PASSWORD=
INTERNAL_API_KEY=change-this-key
JWT_SECRET=replace-with-a-base64-secret-of-at-least-32-bytes
JWT_EXPIRATION=15m
JWT_ISSUER=nexo-ecommerce
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
AUTH_ADMIN_NAME=Administrador
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=change-this-password

# Orders
ORDERS_POSTGRES_DB=orders_db
ORDERS_POSTGRES_USER=postgres
ORDERS_POSTGRES_PASSWORD=change-this-password
ORDERS_DATABASE_URL=jdbc:postgresql://orders-postgres:5432/orders_db
ORDERS_DATABASE_USERNAME=postgres
ORDERS_DATABASE_PASSWORD=change-this-password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=change-this-user
RABBITMQ_PASSWORD=change-this-password
CURRENCY=PEN
STRIPE_API_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Catalog
CATALOG_POSTGRES_DB=catalog_db
CATALOG_POSTGRES_USER=postgres
CATALOG_POSTGRES_PASSWORD=change-this-password
CATALOG_DATABASE_URL=jdbc:postgresql://catalog-postgres:5432/catalog_db
CATALOG_DATABASE_USERNAME=postgres
CATALOG_DATABASE_PASSWORD=change-this-password
CATALOG_SERVER_PORT=8081
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-me
CDN_URL=https://replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Notifications
NOTIFICATIONS_SERVER_PORT=8083
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_FROM=no-reply@example.com
RABBITMQ_RETRY_MAX_ATTEMPTS=3
RABBITMQ_RETRY_INITIAL_INTERVAL=1000ms
RABBITMQ_RETRY_MULTIPLIER=2
RABBITMQ_RETRY_MAX_INTERVAL=5000ms
EUREKA_CLIENT_ENABLED=true

# Discovery y Gateway
EUREKA_URL=http://discovery:8761/eureka/
DISCOVERY_BIND_ADDRESS=0.0.0.0
DISCOVERY_PORT=8761
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_PORT=8082
GATEWAY_HOST_BIND=127.0.0.1
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
AUTH_ROUTE_URI=lb://AUTH-SERVICE
ORDERS_ROUTE_URI=lb://ORDERS-SERVICE
CATALOG_ROUTE_URI=lb://CATALOG-SERVICE
NOTIFICATIONS_ROUTE_URI=lb://NOTIFICATIONS-SERVICE
ORDERS_SERVICE_URL=http://orders:8080
AUTH_SERVICE_URL=http://auth:8084
