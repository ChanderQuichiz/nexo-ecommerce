# ==========================================
# NEXO ECOMMERCE - LOCAL DEV ENVIRONMENT (.env.example)
# Copiar este archivo a .env para desarrollo local
# ==========================================

# Auth Service Secrets & Admin Bootstrap
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=example_admin_password
AUTH_JWT_SECRET=example_dev_jwt_secret_key_minimum_32_bytes
AUTH_INTERNAL_API_KEY=example_internal_api_key

# Catalog Service AWS Secrets
CATALOG_AWS_ACCESS_KEY_ID=example_aws_access_key
CATALOG_AWS_SECRET_ACCESS_KEY=example_aws_secret_key

# Orders Service Stripe Secrets
ORDERS_STRIPE_API_KEY=sk_test_example_placeholder
ORDERS_STRIPE_WEBHOOK_SECRET=whsec_example_placeholder

# Notifications Service Secrets & Mail Identity
NOTIFICATIONS_MAIL_USERNAME=example_sender@gmail.com
NOTIFICATIONS_MAIL_PASSWORD=example_app_password
NOTIFICATIONS_MAIL_FROM=no-reply@nexo-ecommerce.com
NOTIFICATIONS_INTERNAL_API_KEY=example_internal_api_key
